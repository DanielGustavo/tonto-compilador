package RolePattern

//=============================================
// ROLE COMPLETO: general kind + relator com mediação
kind Pessoa

role Cliente specializes Pessoa

relator Contratacao {
    @mediation [1..*] -- [1..*] Cliente
}

//=============================================
// ROLE COMPLETO: general role
kind Organizacao

role Funcionario specializes Organizacao
role Gerente specializes Funcionario

relator Contratacao_De_Funcionario {
    @mediation [1..*] -- [1..*] Funcionario
}

relator Promocao_A_Gerente {
    @mediation [1..*] -- [1..*] Gerente
}

//=============================================
// ROLE COMPLETO COM DEPENDÊNCIA HERDADA: general roleMixin
roleMixin Consumidor

role Cliente_Premium specializes Consumidor

relator Consumo {
    @mediation [1..*] -- [1..*] Consumidor
}

//=============================================
// DEDUÇÃO: role sem relator/mediação
kind Animal

role Filhote specializes Animal

//=============================================
// ERRO: role sem general
role Sem_Pai

// ERRO: role com general inválido (mode)
mode Sintoma

role Invalido specializes Sintoma

//=============================================
// DEDUÇÃO: irmãos role sob o mesmo general sem genset
kind Veiculo

role Motorista specializes Veiculo
role Passageiro specializes Veiculo

relator Viagem_Do_Motorista {
    @mediation [1..*] -- [1..*] Motorista
}

relator Viagem_Do_Passageiro {
    @mediation [1..*] -- [1..*] Passageiro
}

//=============================================
// COMPLETO: irmãos role sob o mesmo general com genset
kind Conta

role Titular specializes Conta
role Dependente specializes Conta

disjoint complete genset Papeis_Da_Conta {
    general Conta
    specifics Titular, Dependente
}

relator Titularidade {
    @mediation [1..*] -- [1..*] Titular
}

relator Dependencia {
    @mediation [1..*] -- [1..*] Dependente
}

//=============================================
// COERÇÃO: @material entre relator e role vira mediação efetiva
kind Comprador_Base

role Comprador specializes Comprador_Base

relator Compra

@material relation Compra [1..*] -- [1..*] Comprador

//=============================================
// REGRESSÃO: subkind mediado por relator NÃO vira role
kind Alimento

subkind Pizza specializes Alimento

relator Preparo {
    @mediation [1..*] -- [1..*] Pizza
}
