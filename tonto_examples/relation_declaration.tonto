package RelationDeclarationTest

kind University {
    address : string
    @componentOf [1] <>-- [1..*] Department
}

kind Department

kind EmploymentContract

kind Employee

relator CarOwnership {
    @mediation
    -- involvesOwner -- [1] University

    @mediation
    -- involvesProperty -- [1] Department
