package ClassDeclarationTest

kind Unidade_Basica_De_Saude

kind Person {
    name : string
    birthDate : date {const}
}

kind Pessoa {
    nome : string [1]
    endereco : string [1]
    cpf : string [1]
    data_nascimento : date [1]
}

phase Crianca specializes Pessoa

role Medico specializes Pessoa {
    especialidade : Especialidade
}
